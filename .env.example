# Required. Keep the real file mode 0600 and never commit it.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ALLOWED_USER_IDS=123456789
GLM_API_KEY=replace-me

# glm-5.3-flash sees sampled video frames. Plain glm-5.3 receives only
# metadata, captions, and OCR because it is text-only.
GLM_MODEL=glm-5.3-flash
GLM_API_BASE=https://api.z.ai/api/paas/v4
GLM_REASONING_EFFORT=high
# GLM_VISION_ENABLED=true

WORKERS=2
QUEUE_SIZE=8
MAX_VIDEO_SECONDS=240
MAX_DOWNLOAD_MB=100
JOB_TIMEOUT_SECONDS=300
TESSERACT_LANGS=eng+ukr+rus
LISTEN_ADDRESS=:8080

# Use an immutable tag emitted by CI, e.g. sha-0123456789abcdef...
IMAGE_TAG=sha-replace-me

